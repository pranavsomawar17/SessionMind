# REQUIRED: Groq is used for BOTH speech-to-text and meeting intelligence.
GROQ_API_KEY=gsk_your_key_here
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional: chat/report model. The app verifies availability and falls back automatically.
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Optional comma-separated keys for rotation.
# GROQ_API_KEYS=gsk_key1,gsk_key2
