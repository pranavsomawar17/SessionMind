# SessionMind settings. Copy this file to .env (run.sh does it for you) and edit.
# Lines starting with # are comments. Never commit or share your real .env.

# =====================================================================
# 1. Choose your engines (each one is independent)
# =====================================================================
# LLM_PROVIDER     groq | ollama                       who analyses the transcript
# STT_PROVIDER     groq | whisper | faster_whisper     who turns audio into text
# VISION_PROVIDER  auto | groq | ollama | none         who reads captions/slides from screenshots
#                  (auto = follows LLM_PROVIDER, so a local setup never sends images to a cloud service)
#
# Cloud (default, easiest):  LLM_PROVIDER=groq    STT_PROVIDER=groq
# Fully local, nothing leaves your machine:
#                            LLM_PROVIDER=ollama  STT_PROVIDER=whisper   (or faster_whisper)
LLM_PROVIDER=groq
STT_PROVIDER=groq
VISION_PROVIDER=auto

# =====================================================================
# 2. Groq (cloud). Needed only if a provider above is "groq"
# =====================================================================
# Several keys can be listed, separated by commas; they are rotated when one is rate limited.
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# GROQ_VISION_MODEL=            # optional; picked automatically when empty

# =====================================================================
# 3. Ollama (local LLM). Needed if LLM_PROVIDER=ollama
#    Install from https://ollama.com, then:  ollama pull qwen2.5:7b-instruct
# =====================================================================
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Context window sent with every request. Ollama's own default is small and silently cuts long
# prompts. Bigger = more memory. 16384 is a good start.
OLLAMA_NUM_CTX=16384
# OLLAMA_KEEP_ALIVE=30m         # keep the model loaded between calls
# OLLAMA_TIMEOUT=600            # seconds to wait for one answer (CPU-only machines may need more)
# OLLAMA_VISION_MODEL=llama3.2-vision   # optional: read captions/slides from screenshots locally
# LLM_CONCURRENCY=1             # parallel requests to the model; keep 1 for a single GPU/CPU

# =====================================================================
# 4. Local Whisper. Needed if STT_PROVIDER=whisper or faster_whisper
#    Install:  pip install -r requirements-local.txt   (or ./run.sh --local)
# =====================================================================
# Model size. tiny/base/small run on a CPU; medium/large-v3/turbo want a GPU.
WHISPER_MODEL=small
# Spoken language code (en, hi, mr, ...). Empty = detect automatically per chunk. Setting it is
# more accurate and avoids a chunk being mis-detected as the wrong language.
WHISPER_LANGUAGE=
# Names and jargon to help recognition, e.g. "Participants: Priya, Rahul, Meera. Terms: CloudNine, Acme."
WHISPER_PROMPT=
# WHISPER_DEVICE=auto           # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=         # faster_whisper only; default float16 on GPU, int8 on CPU
# Seconds of audio per upload. Default 10 for Groq, 20 for local Whisper (more context, less overhead).
# If local transcription falls behind the meeting, raise this or use a smaller WHISPER_MODEL.
# CHUNK_SECONDS=

# =====================================================================
# 5. Advanced
# =====================================================================
# SCAN_WINDOW_CHARS=4000        # size of the transcript slice the model reads at once (Groq 6000, Ollama 4000)
# LLM_MAX_INPUT_CHARS=          # how much transcript one report call may carry (derived from the model/context)
# LIVE_MAX_WINDOWS=2            # slices analysed per live poll
# DATA_DIR=./data               # where the database, reports and media live
# LOG_LEVEL=INFO
